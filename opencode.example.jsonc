{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      // All entries point at the same local server - llama-server only
      // loads one model at a time, so whichever model name you pick here
      // just labels whatever's actually running on port 8080. Restart the
      // server with the matching launch script to actually switch.
      "models": {
        "qwen3-coder-30b-a3b": {
          "name": "Qwen3-Coder-30B-A3B (local, default - fast)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3-coder-next": {
          "name": "Qwen3-Coder-Next (local, slower - use for hard problems)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "gpt-oss-20b": {
          "name": "gpt-oss-20b (local, reasoning model - see README before use)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "gemma-4-26b-a4b": {
          "name": "Gemma 4 26B A4B QAT (local, general-purpose - not coding-specialized)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
